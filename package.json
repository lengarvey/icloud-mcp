{
  "name": "icloud-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server on Cloudflare Workers proxying iCloud Mail (IMAP), Calendar (CalDAV), and Contacts (CardDAV)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:hostname": "node scripts/write-hostname.mjs",
    "pretypecheck": "node scripts/write-hostname.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/write-hostname.mjs && node --test scripts/secret-files.test.mjs",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot",
    "predeploy": "node scripts/write-hostname.mjs",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke-unauthenticated.mjs",
    "scan": "node scripts/forbidden-tokens.mjs && node scripts/secret-files.mjs --tracked",
    "docs:tools": "node scripts/tool-table.mjs --check",
    "prepare": "husky && node scripts/write-hostname.mjs",
    "test:secrets": "node --test scripts/secret-files.test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.30.1",
    "aws4fetch": "1.0.20",
    "ical.js": "2.2.1",
    "postal-mime": "4.1.4",
    "tsdav": "2.5.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "husky": "9.1.7",
    "oauth-provider-legacy": "npm:@cloudflare/workers-oauth-provider@0.10.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/vitest-plugin": {
      "zod": "$zod"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
